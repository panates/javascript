{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "noLib": false,
    "noImplicitAny": false,
    "incremental": false,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true
  }
}
